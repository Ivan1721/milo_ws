<?xml version="1.0"?>
<!-- Brazo de Milo en SIMULACIÓN: ros2_control con Gazebo Classic (gazebo_ros2_control).
     Solo se incluye con arm_control:=true y lock_arm:=false (lo hace andesrobot_arm/arm_sim.launch.py).
     El robot real todavía no tiene driver para el brazo: esto es solo para Gazebo. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Una articulación del brazo mandada en VELOCIDAD: arm_controller calcula la velocidad
       con un P sobre el error de posición (ganancias en arm_controllers.yaml) y Gazebo mueve la
       articulación a esa velocidad. Se lee posición y velocidad. initial_value = arranca en 0.
       Antes iban en POSICIÓN, pero gazebo_ros2_control (0.4.10) pone la articulación en la
       posición pedida de un salto en cada paso, sin velocidad: el brazo se movía bien, pero un
       objeto agarrado no subía con la pinza (el roce actúa sobre la velocidad entre las
       superficies y no la había). Medido el 7-nov con scripts/prueba_levantar.py: con posición
       la caja subió 0 mm de 50; con velocidad, 50 mm. -->
  <xacro:macro name="arm_velocity_joint" params="name">
    <joint name="${name}">
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <!-- type="system" = un solo "hardware" (Gazebo) que maneja todas estas articulaciones. -->
  <ros2_control name="milo_arm_sim" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <!-- Lift + 6 articulaciones del brazo: las mueve arm_controller en una sola trayectoria. -->
    <xacro:arm_velocity_joint name="vertical_lift_joint"/>
    <xacro:arm_velocity_joint name="joint_1"/>
    <xacro:arm_velocity_joint name="joint_2"/>
    <xacro:arm_velocity_joint name="joint_3"/>
    <xacro:arm_velocity_joint name="joint_4"/>
    <xacro:arm_velocity_joint name="joint_5"/>
    <xacro:arm_velocity_joint name="joint_6"/>

    <!-- Pinza: los dedos se mandan por ESFUERZO (fuerza, en N), no por posición. Con posición,
         Gazebo pone el dedo donde se le pide aunque haya un objeto en medio: lo atraviesa o lo
         expulsa. Con esfuerzo, gripper_controller calcula la fuerza con un PID (ganancias en
         arm_controllers.yaml) y Gazebo la recorta al tope gripper_force del URDF: al cerrar
         sobre un objeto el dedo se frena contra él y sigue empujando con esa fuerza, como el
         servo real trabado.
         Cada dedo tiene su propio PID y se mandan los DOS, en espejo (izquierdo = −derecho).
         Antes el izquierdo era "mimic" (el plugin le copiaba la fuerza del derecho), pero así no
         tiene control de posición propio: cuando el derecho llega, la fuerza vale 0 y el
         izquierdo queda suelto donde esté (medido el 7-nov: -11 mm en vez de -16 al abrir).
         Si el objeto no está centrado, cada dedo se frena donde lo toca. -->
    <xacro:macro name="dedo_esfuerzo" params="name">
      <joint name="${name}">
        <command_interface name="effort"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <xacro:dedo_esfuerzo name="right_finger_joint"/>
    <xacro:dedo_esfuerzo name="left_finger_joint"/>
  </ros2_control>

  <!-- Física de los dedos en Gazebo.
       implicitSpringDamper: el amortiguamiento gripper_damping es grande para un dedo de ~22 g;
       calculado paso a paso de la forma simple (explícita) haría oscilar al dedo, así que se
       resuelve de forma implícita, que es estable con cualquier valor.
       mu1/mu2: roce de las caras de los dedos (1.0, como goma dura sobre plástico) para que el
       objeto no resbale.
       kp/kd: rigidez [N/m] y amortiguamiento [N·s/m] del contacto. Por defecto el contacto de
       ODE es casi infinitamente rígido; con el dedo apretando 20 N, 3 de cada 10 cierres daban
       saltos de 3 a 6 mm y uno atravesó la caja (medido el 7-nov con scripts/prueba_pinza.py).
       Más blando y amortiguado (kp 1e5, kd 100) los saltos desaparecieron, pero con un objeto
       colgando de los dedos el contacto blando también ablanda el roce y la caja se "arrastra"
       hacia abajo de a poco (0.5 kg: 1.2 mm en 10 s, scripts/prueba_levantar.py). Con kp = 1e6
       el dedo se hunde 20 N / 1e6 N/m = 0.02 mm, no hay saltos (fase 1: 6 de 6, temblor de la
       apertura < 0.25 mm) y una caja de 0.1 a 0.5 kg se corre 0.05–0.4 mm en 10 s.
       kd = 300 queda cerca del amortiguamiento crítico del dedo (2·√(kp·m) ≈ 297 con m ≈ 22 g).
       Probado y descartado: minDepth 0.5–1 mm y maxVel 0 (los dedos se hunden 0.5–1 mm en el
       objeto y los saltos siguen). -->
  <xacro:macro name="dedo_gazebo" params="lado">
    <gazebo reference="${lado}_finger_joint">
      <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>
    <gazebo reference="${lado}_finger_link_1">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>300.0</kd>
    </gazebo>
  </xacro:macro>
  <xacro:dedo_gazebo lado="right"/>
  <xacro:dedo_gazebo lado="left"/>

  <!-- Plugin que corre el controller_manager dentro de Gazebo. Lee el URDF desde
       robot_state_publisher y los controladores desde arm_controllers_file. -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(arg arm_controllers_file)</parameters>
    </plugin>
  </gazebo>

</robot>
