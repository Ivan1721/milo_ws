    <visual>  <!-- placa trasera -->
      <origin rpy="0 0 0" xyz="-0.1210 0.0000 0.1150"/>
      <geometry><box size="0.0020 0.5040 0.2700"/></geometry>
      <material name="placa_carcasa"/>
    </visual>
    <visual>  <!-- placa delantera -->
      <origin rpy="0 0 0" xyz="0.3810 0.0000 0.1150"/>
      <geometry><box size="0.0020 0.5040 0.2700"/></geometry>
      <material name="placa_carcasa"/>
    </visual>
    <visual>  <!-- placa tapa trasera -->
      <origin rpy="0 0 0" xyz="-0.0760 0.0000 0.2510"/>
      <geometry><box size="0.0920 0.5040 0.0020"/></geometry>
      <material name="placa_carcasa"/>
    </visual>
    <visual>  <!-- placa tapa delantera -->
      <origin rpy="0 0 0" xyz="0.2060 0.0000 0.2510"/>
      <geometry><box size="0.3520 0.5040 0.0020"/></geometry>
      <material name="placa_carcasa"/>
    </visual>
    <visual>  <!-- placa tapa al lado de la columna izq -->
      <origin rpy="0 0 0" xyz="0.0000 0.1410 0.2510"/>
      <geometry><box size="0.0600 0.2220 0.0020"/></geometry>
      <material name="placa_carcasa"/>
    </visual>
    <visual>  <!-- placa tapa al lado de la columna der -->
      <origin rpy="0 0 0" xyz="0.0000 -0.1410 0.2510"/>
      <geometry><box size="0.0600 0.2220 0.0020"/></geometry>
      <material name="placa_carcasa"/>
    </visual>
  </link>
  <joint name="base_to_panels_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="base_link"/>
    <child link="base_panels_link"/>
  </joint>
  <!-- ===== Cabeza (rescatada del STEP del robot antiguo "preparacion ros2 brazo milo v6", sub-ensamble "Configuración 1 v9") =====
     Carcasa impresa + RealSense D435 + pantalla (modelo Venus Touch / CCGX), en la cara FRONTAL de la columna,
     espalda de la carcasa pegada a la cara del 6060, techo 10 cm bajo el extremo superior del perfil
     (base de la carcasa a 1.253 m sobre el pie de la columna). Mallas en mm con las coordenadas del STEP viejo;
     el joint las lleva al frame de la columna (STEP x=130 mm, z=-500 mm = centro/pie de la columna).
     Masas: carcasa PLA 650 g (voxeles, 4 paredes, 60 % relleno), D435 72 g (ficha Intel),
     pantalla 150 g ESTIMADA (pesar). OJO: la cabeza ocupa el final del recorrido del carro: con el carro sobre ~+0.43 m
     (vertical_lift, máx 0.6) o con el brazo estirado hacia arriba, chocan. -->
  <material name="cabeza_carcasa"><color rgba="0.22 0.22 0.24 1.0"/></material>
  <material name="cabeza_marco"><color rgba="0.03 0.03 0.03 1.0"/></material>
  <material name="cabeza_vidrio"><color rgba="0.05 0.10 0.22 1.0"/></material>
  <material name="cabeza_realsense"><color rgba="0.38 0.39 0.42 1.0"/></material>
  <link name="cabeza_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.00048 -0.00049 0.66631"/>
      <mass value="0.8717"/>
      <inertia ixx="4.159000e-03" ixy="1.706704e-08" ixz="-3.323805e-04" iyy="3.281323e-03" iyz="-1.770338e-06" izz="3.977038e-03"/>
    </inertial>
    <visual>  <!-- carcasa impresa -->
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="file://$(find andesrobot_description)/meshes/cabeza_carcasa.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="cabeza_carcasa"/>
    </visual>
    <visual>  <!-- pantalla: marco -->
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="file://$(find andesrobot_description)/meshes/cabeza_pantalla_marco.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="cabeza_marco"/>
    </visual>
    <visual>  <!-- pantalla: vidrio -->
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="file://$(find andesrobot_description)/meshes/cabeza_pantalla_vidrio.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="cabeza_vidrio"/>
    </visual>
    <visual>  <!-- cámara RealSense D435 -->
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="file://$(find andesrobot_description)/meshes/cabeza_realsense_d435.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="cabeza_realsense"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0.01565 -0.00045 0.66220"/>
      <geometry><box size="0.1271 0.1607 0.1466"/></geometry>
    </collision>
  </link>
  <joint name="columna_to_cabeza_joint" type="fixed">
    <!-- x -0.1392: espalda de la carcasa (x 79.2 mm en el STEP) pegada a la cara frontal del 6060 (x -0.06 en la columna).
         z 0.6645: techo de la carcasa (735.5 mm en el STEP) 10 cm bajo el extremo del perfil (1.500 m en la columna).
         En el STEP viejo estaba en (-0.16, 0, 0.5): 21 mm separada y 16.45 cm más abajo. -->
    <origin rpy="0 0 0" xyz="-0.1392 0 0.6645"/>
    <parent link="vertical_column_link_1"/>
    <child link="cabeza_link"/>
  </joint>

<!-- Simulación (Gazebo): lidar, diff drive, IMU, joint states. Va al final porque usa lock_arm. -->
<!-- (Las etiquetas <gazebo> solo las lee Gazebo; en el robot real se ignoran.) -->
<xacro:include filename="$(find andesrobot_description)/urdf/andesrobot.sim.xacro" />

<!-- Milo físico: ros2_control con el hoverboard -->
<!-- Solo con use_hardware:=true (robot.launch.py). Agrega el bloque <ros2_control> que le dice al
     controller_manager qué driver cargar y qué ruedas maneja. hoverboard_port = puerto serie. -->
<xacro:arg name="use_hardware" default="false"/>
<xacro:arg name="hoverboard_port" default="/dev/hoverboard"/>
<xacro:if value="$(arg use_hardware)">
  <xacro:include filename="$(find andesrobot_description)/urdf/andesrobot.ros2_control.xacro" />
</xacro:if>

<!-- Brazo en simulación: ros2_control con Gazebo (solo con arm_control:=true). -->
<xacro:if value="${arm_control and not lock_arm}">
  <xacro:include filename="$(find andesrobot_description)/urdf/andesrobot.arm_control.xacro" />
</xacro:if>
<!-- Cámara Orbbec Gemini Plus detrás de la muñeca (solo con gripper_camera:=true): cuerpo, soporte,
     frames de cada lente y sus sensores en Gazebo (color, profundidad + nube, infrarrojo).
     Por defecto no, así la simulación de mapeo no cambia. La activa andesrobot_arm/arm_sim.launch.py. -->
<xacro:arg name="gripper_camera" default="false"/>
<xacro:if value="$(arg gripper_camera)">
  <xacro:include filename="$(find andesrobot_description)/urdf/andesrobot.gripper_camera.xacro" />
</xacro:if>

</robot>
