  <!-- ===== Monitor portátil 12" (genérico ~275 x 175 x 8 mm, ~0.5 kg; el MUCAI de 12" no tiene ficha publicada) =====
       En la cara trasera de la columna 6060, entre la tapa de la caja trasera (0.75 m) y la punta de la columna
       (1.52 m): centro a 1.135 m. Pantalla hacia atrás, inclinada 20° hacia arriba para una persona de pie detrás
       (ojos a ~1.6 m, a ~1.3 m). Brazo impreso de 40 mm + placa a la ranura del perfil. Origen = centro de la espalda. -->
  <material name="monitor_cuerpo">
    <color rgba="0.20 0.20 0.22 1.0"/>
  </material>
  <material name="monitor_pantalla">
    <color rgba="0.02 0.03 0.06 1.0"/>
  </material>
