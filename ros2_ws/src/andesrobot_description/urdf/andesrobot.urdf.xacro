      <material name="monitor_soporte"/>
    </visual>
  </link>
  <joint name="base_to_monitor_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.070 0 1.135"/>
    <parent link="base_link"/>
    <child link="monitor_link"/>
  </joint>
