<?xml version="1.0"?>
<!-- Milo físico: ruedas motrices vía hoverboard (driver en ros2_ws/src/drivers/hoverboard_hardware_interface,
     con la calibración de Milo; firmware hack-FOC, VARIANT_USART).
     Solo se incluye con use_hardware:=true. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Bloque que lee el controller_manager (ros2_control). type="system" = un solo hardware que
       maneja varias articulaciones a la vez (las dos ruedas por un mismo puerto serie). -->
  <ros2_control name="milo_base" type="system">
    <hardware>
      <!-- Qué driver cargar: la clase del plugin (registrada en hoverboard_hardware_interface.xml). -->
      <plugin>hoverboard_hardware_interface/HoverboardHardwareInterface</plugin>
      <!-- Parámetros que lee el driver en on_init(): -->
      <param name="left_wheel_joint_name">left_wheel_joint</param>
      <param name="right_wheel_joint_name">right_wheel_joint</param>
      <!-- Frecuencia de lazo (Hz), puerto serie, velocidad del puerto (baudios) y timeout (ms). -->
      <param name="loop_rate">50</param>
      <param name="device">$(arg hoverboard_port)</param>
      <param name="baud_rate">115200</param>
      <param name="timeout">1000</param>
      <!-- motor de hoverboard: 15 pares de polos x 6 pasos Hall = 90 ticks/vuelta -->
      <param name="encoder_ticks_per_revolution">90</param>
    </hardware>
    <!-- Por cada rueda: se COMANDA en velocidad (rad/s) y se LEE posición (rad) y velocidad.
         El diff_drive_controller usa exactamente estas interfaces. -->
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
