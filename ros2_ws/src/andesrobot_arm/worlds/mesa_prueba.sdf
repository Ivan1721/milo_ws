<?xml version="1.0"?>
<!-- Mesa de prueba para el brazo y la cámara de la pinza (la pone arm_sim.launch.py con mesa:=true).
     Milo aparece en (0, 0) mirando a +X: la mesa queda delante, con el borde a 0.70 m del eje de
     las ruedas (el frente de Milo está en x = 0.436). Encima, tres objetos de colores distintos
     dentro del alcance del brazo (a 0.75 m de altura llega hasta x ~ 0.89 m) y a más de 0.25 m de
     la cámara (su distancia mínima).
     Cada <link> sin <joint> es un cuerpo libre: la mesa es uno pesado (no se mueve al tocarla) y
     cada objeto es otro, liviano, que el brazo puede empujar o tomar.
     Medidas en metros; en cada <pose> la z es el centro de la pieza. -->
<sdf version="1.6">
  <model name="mesa_prueba">
    <static>false</static>
    <!-- self_collide: por defecto Gazebo NO hace chocar los links de un mismo modelo, y los objetos
         atravesarían la mesa hasta el suelo. Con true chocan entre sí como cuerpos separados. -->
    <self_collide>true</self_collide>
    <!-- Mesa: tablero de 0.6 x 0.8 m a 0.72 m de alto, sobre un bloque (pata) más chico. -->
    <link name="mesa">
      <pose>1.0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.36 0 0 0</pose>
        <mass>30.0</mass>
        <inertia><ixx>3.0</ixx><iyy>3.0</iyy><izz>3.0</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="tablero_c"><pose>0 0 0.70 0 0 0</pose>
        <geometry><box><size>0.6 0.8 0.04</size></box></geometry></collision>
      <visual name="tablero_v"><pose>0 0 0.70 0 0 0</pose>
        <geometry><box><size>0.6 0.8 0.04</size></box></geometry>
        <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material></visual>
      <collision name="pata_c"><pose>0 0 0.34 0 0 0</pose>
        <geometry><box><size>0.5 0.7 0.68</size></box></geometry></collision>
      <visual name="pata_v"><pose>0 0 0.34 0 0 0</pose>
        <geometry><box><size>0.5 0.7 0.68</size></box></geometry>
        <material><ambient>0.35 0.25 0.15 1</ambient><diffuse>0.35 0.25 0.15 1</diffuse></material></visual>
    </link>

    <!-- Cubo rojo de 5 cm (100 g). Inercia de un cubo: m a² / 6. -->
    <link name="cubo_rojo">
      <pose>0.78 -0.15 0.745 0 0 0.3</pose>
      <inertial><mass>0.1</mass>
        <inertia><ixx>4.2e-5</ixx><iyy>4.2e-5</iyy><izz>4.2e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="c"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        <material><ambient>0.85 0.1 0.1 1</ambient><diffuse>0.85 0.1 0.1 1</diffuse></material></visual>
    </link>

    <!-- Cilindro verde de 3 cm de radio y 10 cm de alto (150 g). -->
    <link name="cilindro_verde">
      <pose>0.80 0.05 0.77 0 0 0</pose>
      <inertial><mass>0.15</mass>
        <inertia><ixx>1.6e-4</ixx><iyy>1.6e-4</iyy><izz>6.8e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="c"><geometry><cylinder><radius>0.03</radius><length>0.10</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.03</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.1 0.7 0.2 1</ambient><diffuse>0.1 0.7 0.2 1</diffuse></material></visual>
    </link>

    <!-- Caja azul de 4 x 8 x 12 cm (150 g), de pie. -->
    <link name="caja_azul">
      <pose>0.85 0.22 0.78 0 0 -0.4</pose>
      <inertial><mass>0.15</mass>
        <inertia><ixx>2.6e-4</ixx><iyy>2.0e-4</iyy><izz>1.0e-4</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="c"><geometry><box><size>0.04 0.08 0.12</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.04 0.08 0.12</size></box></geometry>
        <material><ambient>0.15 0.3 0.85 1</ambient><diffuse>0.15 0.3 0.85 1</diffuse></material></visual>
    </link>
  </model>
</sdf>
