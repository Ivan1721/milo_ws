<!-- Descripción del plugin para pluginlib:
     path = nombre de la librería compilada (libhoverboard_hardware_interface.so)
     name = nombre con que se pide en el URDF (<plugin> en andesrobot.ros2_control.xacro)
     type = la clase C++ que implementa el plugin
     base_class_type = de qué tipo de plugin se trata (un SystemInterface de ros2_control) -->
<library path="hoverboard_hardware_interface">
  <class name="hoverboard_hardware_interface/HoverboardHardwareInterface"
         type="hoverboard_hardware_interface::HoverboardHardwareInterface"
         base_class_type="hardware_interface::SystemInterface">
    <description>
        The hoverboard motors hardware interface for ros2_control
    </description>
  </class>
</library>