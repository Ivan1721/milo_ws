<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- package.xml: "ficha" del paquete ROS (nombre, quién lo mantiene, de qué depende). -->
<package format="3">
  <name>andesrobot_moveit_config</name>
  <version>0.1.0</version>
  <description>Configuración de MoveIt 2 para el brazo de Milo: SRDF, cinemática, límites, controladores y OctoMap de la cámara de la pinza.</description>
  <maintainer email="garciaivan172@gmail.com">Ivan1721</maintainer>
  <license>Apache-2.0</license>

  <!-- Solo archivos de configuración: lo que los lee es move_group (moveit_ros_move_group),
       lanzado desde andesrobot_arm/launch/arm_sim.launch.py con MoveItConfigsBuilder. -->
  <exec_depend>andesrobot_description</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>moveit_ros_perception</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
