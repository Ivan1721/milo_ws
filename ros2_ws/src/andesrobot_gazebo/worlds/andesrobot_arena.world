<?xml version="1.0"?>
<!-- AndesRobot — arena de mapeo v2 (Gazebo Classic 11), 24 x 18 m.
     Zonas: hall central, oficina, bodega (3 pasillos), zona colapsada (escombros), zona de pilares.
     Diseño verificado para Milo + filtro de seguridad:
       - puertas >= 2.2 m, pasos con >= 1.4 m libres (Milo gira en el lugar en todo el recorrido)
       - todos los obstáculos >= 0.5 m de alto (el RPLIDAR C1 escanea a 0.36 m)
     Spawn: (0, 0), mirando +X. -->
<!-- Formato SDF (el de Gazebo para mundos). Mapa de la arena con recorrido sugerido:
     andesrobot_arena.png en esta misma carpeta. Coordenadas en metros; (0,0) = centro. -->
<sdf version="1.6">
  <world name="andesrobot_arena">
    <!-- Luz y suelo: modelos que trae Gazebo. -->
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <!-- Motor de física ODE: pasos de 1 ms, 1000 pasos por segundo = tiempo real (factor 1). -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <!-- Sin sombras (más liviano para la GPU). -->
    <scene><shadows>false</shadows></scene>
    <!-- Cámara inicial de la ventana de Gazebo: arriba y al sur, mirando la arena entera. -->
    <gui><camera name="user_camera"><pose>0 -20 22 0 0.85 1.5708</pose></camera></gui>
    <!-- CÓMO ESTÁ HECHO CADA OBJETO (todos siguen este patrón):
         <model name="...">          un objeto
           <static>true</static>     no se mueve ni cae (no lo empuja la física)
           <pose>x y z r p yaw</pose> posición del centro (z = mitad de la altura, así toca el suelo)
                                     y giro yaw en radianes
           <collision>               forma con la que choca (y la que ve el lidar)
           <visual>                  forma que se ve (la misma), con su color (ambient/diffuse RGBA)
         Formas: <box><size>largo ancho alto</size>  o  <cylinder> radio + alto (length). -->
    <!-- MUROS (1.5 m de alto, 15 cm de grosor). 00-03 = perímetro de 24 x 18 m; el resto divide las zonas
         dejando puertas de 2.2 m. -->
    <model name="muro_00">
      <static>true</static>
      <pose>0.000 -9.000 0.750 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>24.150 0.15 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>24.150 0.15 1.5</size></box></geometry>
          <material><ambient>0.78 0.76 0.72 1</ambient><diffuse>0.78 0.76 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="muro_01">
      <static>true</static>
      <pose>0.000 9.000 0.750 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>24.150 0.15 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>24.150 0.15 1.5</size></box></geometry>
          <material><ambient>0.78 0.76 0.72 1</ambient><diffuse>0.78 0.76 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="muro_02">
      <static>true</static>
      <pose>-12.000 0.000 0.750 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>18.150 0.15 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>18.150 0.15 1.5</size></box></geometry>
          <material><ambient>0.78 0.76 0.72 1</ambient><diffuse>0.78 0.76 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="muro_03">
      <static>true</static>
